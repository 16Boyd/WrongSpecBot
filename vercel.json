{
  "version": 2,
  "buildCommand": "node scripts/run-migrations.js",
  "outputDirectory": null,
  "installCommand": "npm install",
  "ignoreCommand": "git diff HEAD^ HEAD --quiet -- api/ src/ package.json vercel.json scripts/ supabase-setup.sql supabase-migration.sql supabase-server-status.sql supabase-amp-status.sql",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 300
    }
  },
  "routes": [
    {
      "src": "/api/check-prices",
      "dest": "/api/check-prices.ts"
    },
    {
      "src": "/api/server-status",
      "dest": "/api/server-status.ts"
    },
    {
      "src": "/api/amp-status",
      "dest": "/api/amp-status.ts"
    },
    {
      "src": "/api/interactions",
      "dest": "/api/interactions.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    }
  ]
} 